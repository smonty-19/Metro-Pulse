# Copy to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string.
# Get from: Atlas > Cluster > Connect > Drivers > Node.js
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/metropulse?retryWrites=true&w=majority
# Local alternative: mongodb://localhost:27017/metropulse
MONGODB_URI=

# Signing key for JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production without this.
JWT_SECRET=

PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
# In production set this to your deployed frontend URL, e.g. https://metro-pulse.vercel.app
CORS_ORIGIN=http://localhost:3000