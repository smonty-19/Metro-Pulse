# Copy to .env and adjust. Must be UTF-8 - a UTF-16 file (which PowerShell's
# `>` operator produces) is silently ignored by the build, and the app falls
# back to the hardcoded localhost URL.

# Base URL of the backend API, including the /api suffix.
# Production example: https://metropulse-api.onrender.com/api
REACT_APP_API_URL=http://localhost:5000/api

# Port for the dev server. Defaults to 3000; change it if something else is
# already using that port. If you do, update CORS_ORIGIN in backend/.env to
# match, or the API will reject the browser's requests.
# PORT=3001